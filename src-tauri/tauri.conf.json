{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "qr-generator",
  "version": "0.1.0",
  "identifier": "me.ezfoxie.qr-generator",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "vpr dev",
    "beforeBuildCommand": "vpr build"
  },
  "app": {
    "windows": [
      {
        "title": "QR Generator",
        "width": 1320,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
